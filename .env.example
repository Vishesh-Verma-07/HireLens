# Copy to ".env" and fill in. The bot reads this file on startup.

# Email provider. "gmail" fills in the Gmail SMTP/IMAP hosts for you.
# For any other provider, set SMTP_HOST / IMAP_HOST instead.
MAIL_PROVIDER=gmail

# --- SMTP (sending) --------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# --- IMAP (receiving your replies) ----------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true

# --- Credentials -----------------------------------------------------------
# FOR GMAIL: enable 2-Step Verification, then create an "App password":
#   https://myaccount.google.com/apppasswords
# Use that 16-character app password here, NOT your normal account password.
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password

# Optional: separate IMAP credentials (defaults to the SMTP ones).
# IMAP_USER=
# IMAP_PASS=

# --- Who the bot talks to --------------------------------------------------
# Defaults to SMTP_USER (i.e. it emails yourself).
MAIL_FROM=you@gmail.com
MAIL_TO=you@gmail.com

# --- Schedule --------------------------------------------------------------
# Send the daily digest at/after this hour (your machine's local time).
MAIL_DAILY_HOUR=8
# How often to check the inbox for your replies, in minutes.
MAIL_POLL_MINUTES=2

# --- Google Board Scan -----------------------------------------------------
# The scan source needs one of these. SerpAPI is the simplest (one key).
#   https://serpapi.com/
SERPAPI_KEY=
#
# Or use Google's official Custom Search JSON API (free 100 queries/day):
#   https://developers.google.com/custom-search/v1/overview
# The search engine must be set to "Search the entire web".
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=
