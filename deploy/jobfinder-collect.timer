# Starts a collection pass every 6 hours (00:00, 06:00, 12:00, 18:00).
#
#   sudo cp deploy/jobfinder-collect.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now jobfinder-collect.timer
#
# `Persistent=true` runs a missed pass after the machine wakes up, and the
# small random delay keeps the pass from colliding with the bot's poll loop.

[Unit]
Description=Run the jobfinder collection every 6 hours

[Timer]
OnCalendar=*-*-* 00/6:00:00
RandomizedDelaySec=5m
Persistent=true

[Install]
WantedBy=timers.target
